{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "cargo": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchFileNames": ["Cargo.toml", "**/Cargo.toml"],
      "groupName": "cargo dependencies"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
