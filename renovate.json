{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "cargo": {
    "enabled": true
  },
  "docker": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Свежий релиз ждёт неделю: за это время отзывают сломанные и вредоносные версии (yank), и MR с ними не появляется",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["cargo"],
      "matchFileNames": ["Cargo.toml", "**/Cargo.toml"],
      "groupName": "cargo dependencies"
    },
    {
      "matchManagers": ["docker"],
      "matchFileNames": [".gitlab-ci.yml", "**/.gitlab-ci.yml"],
      "groupName": "gitlab images"
    },
    {
      "description": "Образ rust: поднимают руками и вместе с rust-toolchain.toml (docs/conventions.md, «Тулчейн запинен»)",
      "matchManagers": ["docker"],
      "matchPackageNames": ["rust"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
