{
	"version": "0.2.0",
	"configurations": [
		{
			// Подключение к уже работающей плате: ничего не перепрошивает и не
			// сбрасывает, поэтому годится, чтобы поймать состояние, которое
			// возникло до запуска отладчика.
			"type": "probe-rs-debug",
			"request": "attach",
			"name": "Attach to running app (debug build)",
			"cwd": "${workspaceFolder}",
			"chip": "{{chip}}",
			"coreConfigs": [
				{
					"coreIndex": 0,
					"programBinary": "crates-cross/target/{{target}}/debug/app"
				}
			]
		},
		{
			"type": "probe-rs-debug",
			"request": "launch",
			"name": "Debug app (debug build)",
			"cwd": "${workspaceFolder}",
			"chip": "{{chip}}",
			// Не просто сборка: приложение линкуется в ACTIVE, а после сброса
			// управление получает bootloader с базы flash. Задача ниже заливает
			// и его тоже — иначе на плате без bootloader'а F5 приводит в
			// HardFault вместо app::main. У проектов без OTA она прошивает
			// только приложение, так что подходит обоим.
			"preLaunchTask": "xtask: flash debug",
			"flashingConfig": {
				"flashingEnabled": true,
				"resetAfterFlash": true,
				"haltAfterReset": true
			},
			"coreConfigs": [
				{
					"coreIndex": 0,
					"programBinary": "crates-cross/target/{{target}}/debug/app"
				}
			]
		},
		{
			"type": "probe-rs-debug",
			"request": "launch",
			"name": "Debug app (release build)",
			"cwd": "${workspaceFolder}",
			"chip": "{{chip}}",
			// См. конфигурацию debug выше: заливаем bootloader вместе с app.
			"preLaunchTask": "xtask: flash release",
			"flashingConfig": {
				"flashingEnabled": true,
				"resetAfterFlash": true,
				"haltAfterReset": true
			},
			"coreConfigs": [
				{
					"coreIndex": 0,
					"programBinary": "crates-cross/target/{{target}}/release/app"
				}
			]
		}
	]
}
