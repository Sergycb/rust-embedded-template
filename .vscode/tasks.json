{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "xtask: build",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "build"],
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test all",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "all"],
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test host",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "host"],
			"group": "test",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test target",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "target"],
			"group": "test",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test host-target",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "host-target"],
			"group": "test",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: setup",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "setup"],
			"problemMatcher": []
		},
		{
			"label": "xtask: lint cross",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "lint", "cross"],
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: lint",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "lint"],
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: pins",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "pins", "${input:pinsQuery}"],
			"problemMatcher": []
		},
		{
			"label": "xtask: panic-info",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "panic-info"],
			"problemMatcher": []
		},
		// {% if ota == "true" %}
		{
			// Bootloader для отладки из launch.json: приложение линкуется в
			// ACTIVE, а после сброса управление получает то, что лежит с базы
			// flash.
			"label": "flash: boot (debug)",
			"type": "shell",
			"command": "cargo",
			"args": ["flash", "-p", "boot", "--chip", "{{chip}}"],
			"options": { "cwd": "${workspaceFolder}/crates-cross" },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "flash: boot (release)",
			"type": "shell",
			"command": "cargo",
			"args": ["flash", "-p", "boot", "--release", "--chip", "{{chip}}"],
			"options": { "cwd": "${workspaceFolder}/crates-cross" },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "debug: prepare (debug)",
			"dependsOrder": "sequence",
			"dependsOn": ["flash: boot (debug)", "build: app (debug)"],
			"problemMatcher": []
		},
		{
			"label": "debug: prepare (release)",
			"dependsOrder": "sequence",
			"dependsOn": ["flash: boot (release)", "build: app (release)"],
			"problemMatcher": []
		},
		// {% endif %}
		{
			"label": "build: app (debug)",
			"type": "shell",
			"command": "cargo",
			"args": ["build"],
			"options": { "cwd": "${workspaceFolder}/crates-cross/app" },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "build: app (release)",
			"type": "shell",
			"command": "cargo",
			"args": ["build", "--release"],
			"options": { "cwd": "${workspaceFolder}/crates-cross/app" },
			"problemMatcher": ["$rustc"]
		}
	],
	"inputs": [
		{
			"id": "pinsQuery",
			"type": "promptString",
			"description": "Блок (SPI1) или вывод (PA9). Пусто — список блоков чипа",
			"default": ""
		}
	]
}
