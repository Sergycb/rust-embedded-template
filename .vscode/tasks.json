{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "xtask: build",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "build"],
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test all",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "all"],
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test host",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "host"],
			"group": "test",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test target",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "target"],
			"group": "test",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: test host-target",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "test", "host-target"],
			"group": "test",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: setup",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "setup"],
			"problemMatcher": []
		},
		{
			"label": "xtask: lint cross",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "lint", "cross"],
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: lint",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "lint"],
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: pins",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "pins", "${input:pinsQuery}"],
			"problemMatcher": []
		},
		{
			"label": "xtask: flash debug",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "flash", "debug"],
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "xtask: flash release",
			"type": "shell",
			"command": "cargo",
			"args": ["xtask", "flash", "release"],
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "build: app (debug)",
			"type": "shell",
			"command": "cargo",
			"args": ["build"],
			"options": { "cwd": "${workspaceFolder}/cross/app" },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "build: app (release)",
			"type": "shell",
			"command": "cargo",
			"args": ["build", "--release"],
			"options": { "cwd": "${workspaceFolder}/cross/app" },
			"problemMatcher": ["$rustc"]
		}
	],
	"inputs": [
		{
			"id": "pinsQuery",
			"type": "promptString",
			"description": "Блок (SPI1) или вывод (PA9). Пусто — список блоков чипа",
			"default": ""
		}
	]
}
