{
	"rust-analyzer.check.command": "clippy",
	// Отдельные workspace, которые rust-analyzer сам не найдёт: он идёт от
	// корня, а `crates-cross` и `chip-info` объявляют собственные `[workspace]`
	// (первый — потому что собирается под другой target, второй — потому что
	// чип выбирается Cargo-фичей). Без явного перечисления справочник по чипу
	// остаётся для IDE просто набором текстовых файлов.
	//
	// В репозитории САМОГО шаблона третья строка даст постоянную ошибку
	// «failed to load workspace»: чип-фича в манифесте chip-info там ещё
	// плейсхолдер, и такой фичи у stm32-metapac нет. Это ожидаемо — пользу
	// строка приносит там, куда файл и едет, в сгенерированном проекте.
	//
	// Имя плейсхолдера здесь не пишется намеренно: файл проходит
	// Liquid-подстановку (в exclude его нет), и написанное фигурными скобками
	// подменилось бы на реальный чип, превратив объяснение в бессмыслицу.
	"rust-analyzer.linkedProjects": [
		"Cargo.toml",
		"crates-cross/Cargo.toml",
		"crates-host/chip-info/Cargo.toml",
	]
}